# Use the Supabase development project for local testing.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Keep this origin aligned with the local Pages server.
APP_ORIGIN=http://localhost:8788
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Generate a local-only 32-byte key with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=replace_with_generated_base64_key
