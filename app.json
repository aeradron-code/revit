{
  "expo": {
    "name": "revit",
    "slug": "revit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app/icon.png",
    "scheme": "revit",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/adaptive-icon.png",
        "backgroundColor": "#070C1B"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aeradron.revit"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/web/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070C1B",
          "image": "./assets/app/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Revit to select photos for your posts.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "fb4563df-9cd9-4786-98ac-7372bfcc81a5"
      }
    },
    "owner": "aeradron"
  }
}
